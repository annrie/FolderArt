    "長い文字は自動で縮小されます。2〜4 文字が読みやすい大きさです。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langer Text wird automatisch verkleinert. 2–4 Zeichen bleiben gut lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long text is scaled down automatically. 2–4 characters stay readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto largo se reduce automáticamente. 2–4 caracteres se leen bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte long est réduit automatiquement. 2 à 4 caractères restent lisibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文字は自動で縮小されます。2〜4 文字が読みやすい大きさです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문자는 자동으로 축소됩니다. 2~4자가 읽기 좋은 크기입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos longos são reduzidos automaticamente. 2–4 caracteres ficam legíveis."
