    "%lld 件のお気に入りを追加しました (%lld 件は同じものがあるため省略)。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Vorlage(n) hinzugefügt (%lld als identisch übersprungen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld preset(s) (%lld skipped as identical)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadieron %lld favorito(s) (%lld omitidos por ser idénticos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld favori(s) ajouté(s) (%lld ignoré(s) car identique(s))."
